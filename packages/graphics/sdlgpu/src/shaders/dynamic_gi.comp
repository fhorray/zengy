#version 450
// Software traversal of Helios' flat CPU-built BVH. Each group updates one probe;
// immutable previous-grid snapshot avoids inter-workgroup feedback races.
layout(local_size_x=64,local_size_y=1,local_size_z=1) in;
layout(std430,set=0,binding=0) readonly buffer Geometry {uint geom[];};
layout(std430,set=0,binding=1) readonly buffer PreviousGrid {uint old_grid[];};
layout(std430,set=1,binding=0) buffer ClusterOutput {uint lighting[];};
layout(std430,set=1,binding=1) buffer Reservoirs {uvec4 reservoirs[];};
layout(std140,set=2,binding=0) uniform GiParams {
    uvec4 counts; // nodes, triangles, materials, point lights
    uvec4 offsets; // node/triangle/material word offsets, grid word offset
    uvec4 dispatch_info; // cursor, rays per probe, frame index, reset
    uvec4 light_key; // hash lo/hi, reserved
    vec4 config; // max distance, hysteresis, feedback, reserved
    vec4 sun_dir_int;
    vec4 sun_color;
    vec4 sky_zenith;
    vec4 sky_horizon;
    vec4 sky_ground;
    vec4 cdf[64]; // cumulative importance distribution of the existing point-light buffer
};
const float PI=3.14159265359;
const uint PROBE_WORDS=52u;
const uint INVALID=0xffffffffu;
const vec3 axes[6]=vec3[6](vec3(1,0,0),vec3(-1,0,0),vec3(0,1,0),vec3(0,-1,0),vec3(0,0,1),vec3(0,0,-1));
shared vec3 probe_pos;
shared vec3 probe_offset;
shared vec4 ray_result[64];
shared vec4 ray_direction[64];
vec3 finiteRgb(vec3 x){return any(isnan(x))||any(isinf(x))?vec3(0):clamp(x,vec3(0),vec3(1000));}
vec3 norm(vec3 x){return x*inversesqrt(max(dot(x,x),1e-12));}
vec3 geom3(uint i){return uintBitsToFloat(uvec3(geom[i],geom[i+1u],geom[i+2u]));}
vec4 old4(uint i){return uintBitsToFloat(uvec4(old_grid[i],old_grid[i+1u],old_grid[i+2u],old_grid[i+3u]));}
vec4 light4(uint i){return uintBitsToFloat(uvec4(lighting[i],lighting[i+1u],lighting[i+2u],lighting[i+3u]));}
void store4(uint i,vec4 v){uvec4 u=floatBitsToUint(v);lighting[i]=u.x;lighting[i+1u]=u.y;lighting[i+2u]=u.z;lighting[i+3u]=u.w;}
uint probeBase(uint i){return 8u+PROBE_WORDS*i;}
vec3 probeCoords(uint i){return vec3(i%4u,(i/4u)%4u,i/16u);}
uint sector(vec3 d){vec3 a=abs(d);if(a.x>=a.y&&a.x>=a.z)return d.x>=0?0u:1u;if(a.y>=a.z)return d.y>=0?2u:3u;return d.z>=0?4u:5u;}
uint rng(inout uint x){x^=x<<13;x^=x>>17;x^=x<<5;return x;}
float random(inout uint x){return float(rng(x)>>8)*(1.0/16777216.0);}
struct Hit{float t;uint material;vec3 normal;bool found;};
bool aabb(vec3 o,vec3 d,vec3 mn,vec3 mx,float maxT,out float entry){
    float lo=0.001,hi=maxT;
    for(int i=0;i<3;++i){
        if(abs(d[i])<1e-8){if(o[i]<mn[i]||o[i]>mx[i])return false;}
        else {float a=(mn[i]-o[i])/d[i],b=(mx[i]-o[i])/d[i];lo=max(lo,min(a,b));hi=min(hi,max(a,b));if(lo>hi)return false;}
    }
    entry=lo;return true;
}
Hit trace(vec3 o,vec3 d,float maxT,bool anyHit){
    Hit best=Hit(maxT,INVALID,vec3(0,1,0),false);
    if(counts.x==0u||maxT<=0.001)return best;
    uint stack[64];float nearStack[64];int sp=1;float entry;
    if(!aabb(o,d,geom3(offsets.x),geom3(offsets.x+4u),maxT,entry))return best;
    stack[0]=0u;nearStack[0]=entry;
    while(sp>0){
        --sp;uint index=stack[sp];if(nearStack[sp]>best.t||index>=counts.x)continue;
        uint base=offsets.x+index*8u,first=geom[base+3u],n=geom[base+7u];
        if(n>0u){
            if(first>=counts.y||n>counts.y-first)continue;
            for(uint i=0u;i<n;++i){
                uint t=offsets.y+(first+i)*12u;
                if(geom[t+7u]==0u)continue;
                vec3 v0=geom3(t),e1=geom3(t+4u)-v0,e2=geom3(t+8u)-v0;
                vec3 h=cross(d,e2);float determinant=dot(e1,h);
                if(abs(determinant)<1e-7)continue;
                float inv=1.0/determinant;vec3 s=o-v0;float u=dot(s,h)*inv;
                if(u<0.0||u>1.0)continue;vec3 q=cross(s,e1);float v=dot(d,q)*inv;
                if(v<0.0||u+v>1.0)continue;float hitT=dot(e2,q)*inv;
                if(hitT<0.001||hitT>best.t||isnan(hitT)||isinf(hitT))continue;
                best=Hit(hitT,geom[t+3u],norm(cross(e1,e2)),true);
                if(anyHit)return best;
            }
        }else{
            uint l=first,r=l+1u;if(r>=counts.x)continue;
            uint lb=offsets.x+l*8u,rb=offsets.x+r*8u;float dl=0,dr=0;
            bool hl=aabb(o,d,geom3(lb),geom3(lb+4u),best.t,dl),hr=aabb(o,d,geom3(rb),geom3(rb+4u),best.t,dr);
            if(hl&&hr){
                if(sp+2>64){if(anyHit)return Hit(0,INVALID,vec3(0),true);return best;}
                stack[sp]=dl<=dr?r:l;nearStack[sp++]=max(dl,dr);
                stack[sp]=dl<=dr?l:r;nearStack[sp++]=min(dl,dr);
            }else if(hl||hr){
                if(sp>=64){if(anyHit)return Hit(0,INVALID,vec3(0),true);return best;}
                stack[sp]=hl?l:r;nearStack[sp++]=hl?dl:dr;
            }
        }
    }
    return best;
}
vec4 samplePrevious(vec3 p,vec3 n){
    vec3 origin=old4(0u).xyz,spacing=old4(4u).xyz;
    if(any(lessThanEqual(spacing,vec3(0.01))))return vec4(0);
    vec3 q=(p-origin)/spacing;if(any(lessThan(q,vec3(-0.05)))||any(greaterThan(q,vec3(3.05))))return vec4(0);
    q=clamp(q,vec3(0),vec3(3));ivec3 base=min(ivec3(floor(q)),ivec3(2));vec3 f=q-vec3(base);vec3 rgb=vec3(0);float weights=0;
    for(int i=0;i<8;++i){ivec3 o=ivec3(i&1,(i>>1)&1,(i>>2)&1),c=base+o;uint index=uint(c.x+4*c.y+16*c.z),b=probeBase(index);vec4 off=old4(b+48u);
        vec3 w3=mix(1.0-f,f,vec3(o));float w=w3.x*w3.y*w3.z*off.w;if(w<=1e-5)continue;
        vec3 delta=p-(origin+vec3(c)*spacing+off.xyz);uint s=sector(delta);vec4 mom=old4(b+24u+4u*s);if(mom.y<=0)continue;
        float mean=old4(b+4u*s).w,variance=max(mom.x-mean*mean,0.0025),excess=max(length(delta)-mean-0.05,0.0);
        float visibility=variance/(variance+excess*excess);visibility=visibility*visibility*visibility;
        vec3 n2=n*n;vec3 rad=old4(b+4u*(n.x>=0?0u:1u)).rgb*n2.x+old4(b+4u*(n.y>=0?2u:3u)).rgb*n2.y+old4(b+4u*(n.z>=0?4u:5u)).rgb*n2.z;
        rgb+=finiteRgb(rad)*w*visibility;weights+=w;
    }
    return vec4(rgb/max(weights,1e-5),clamp(weights,0,1));
}
float cdfAt(uint i){return cdf[i/4u][i%4u];}
float importancePdf(uint i){return max(cdfAt(i)-(i==0u?0.0:cdfAt(i-1u)),0.0);}
uint importanceSample(float u){uint lo=0u,hi=counts.w-1u;for(int i=0;i<8;++i){if(lo>=hi)break;uint mid=(lo+hi)/2u;if(u<cdfAt(mid))hi=mid;else lo=mid+1u;}return lo;}
vec3 lightContribution(uint index,vec3 p,vec3 n,out vec3 l,out float distance){
    uint base=index*12u;vec4 pr=light4(base),cr=light4(base+4u),sp=light4(base+8u);
    vec3 delta=pr.xyz-p;distance=length(delta);l=delta/max(distance,1e-5);
    if(distance<0.05||distance>=pr.w||pr.w<=0||sp.z<=0)return vec3(0);
    float r=distance/pr.w,w=1-r*r*r*r;
    return finiteRgb(cr.rgb*(w*w/(distance*distance+1.0+sp.x*sp.x))*max(dot(n,l),0));
}
float target(vec3 c){return max(dot(c,vec3(0.2126,0.7152,0.0722)),0.0);}
void clearReservoir(uint base){reservoirs[base]=uvec4(0,0,0,INVALID);reservoirs[base+1u]=uvec4(0);reservoirs[base+2u]=uvec4(0);}
// Four fresh balance-MIS candidates + a validated temporal reservoir. Visibility is
// evaluated only for the selected sample. This is probe-space DI reuse, not full-screen ReSTIR.
vec3 sampleDirect(vec3 p,vec3 n,uint rb,bool canReuse,inout uint state){
    if(counts.w==0u){clearReservoir(rb);return vec3(0);}
    uint selected=INVALID,M=0u;float sum=0,selectedTarget=0;
    for(int i=0;i<4;++i){
        bool importance=random(state)<0.5;float u=random(state);
        uint idx=importance?importanceSample(u):min(uint(u*float(counts.w)),counts.w-1u);
        vec3 l;float distance;vec3 c=lightContribution(idx,p,n,l,distance);float t=target(c);
        float pdf=0.5/float(counts.w)+0.5*importancePdf(idx);float w=t/max(pdf,1e-8);sum+=w;++M;
        if(w>0&&random(state)*sum<w){selected=idx;selectedTarget=t;}
    }
    if(canReuse){uvec4 a=reservoirs[rb],b=reservoirs[rb+1u],c=reservoirs[rb+2u];
        uint idx=a.w,oldM=min(c.x,16u);float oldW=uintBitsToFloat(b.w);
        if(idx<counts.w&&oldM>0u&&c.y==light_key.x&&c.z==light_key.y&&oldW>0&&!isnan(oldW)&&!isinf(oldW)
            && length(uintBitsToFloat(a.xyz)-p)<0.15&&dot(uintBitsToFloat(b.xyz),n)>0.9){
            vec3 l;float distance;float t=target(lightContribution(idx,p,n,l,distance));
            float w=t*oldW*float(oldM);
            if(!isnan(w)&&!isinf(w)&&w>=0){sum+=w;M+=oldM;if(w>0&&random(state)*sum<w){selected=idx;selectedTarget=t;}}
        }
    }
    if(selected==INVALID||selectedTarget<=1e-8){clearReservoir(rb);return vec3(0);}
    float W=sum/(float(M)*selectedTarget);
    if(isnan(W)||isinf(W)||W<=0){clearReservoir(rb);return vec3(0);}
    reservoirs[rb]=uvec4(floatBitsToUint(p),selected);
    reservoirs[rb+1u]=uvec4(floatBitsToUint(n),floatBitsToUint(W));
    reservoirs[rb+2u]=uvec4(M,light_key.x,light_key.y,0);
    vec3 l;float distance;vec3 c=lightContribution(selected,p,n,l,distance);
    return trace(p,l,distance-0.005,true).found?vec3(0):finiteRgb(c*W);
}
void main(){
    uint lane=gl_LocalInvocationIndex,idx=(dispatch_info.x+gl_WorkGroupID.x)%64u,base=probeBase(idx),rb=(idx*64u+lane)*3u;
    uint count=clamp(dispatch_info.y,12u,64u);vec4 prevOff=old4(base+48u);
    vec3 spacing=old4(4u).xyz;
    if(lane==0u){
        vec3 original=old4(0u).xyz+probeCoords(idx)*spacing;
        vec3 oldOffset=prevOff.xyz,shift=vec3(0);vec3 p=original+oldOffset;
        float clearance=min(min(spacing.x,min(spacing.y,spacing.z))*0.15,0.2);
        for(int a=0;a<6;++a){Hit h=trace(p,axes[a],clearance,false);if(h.found)shift-=axes[a]*(clearance-h.t);}
        probe_offset=clamp(oldOffset+shift,-spacing*0.3,spacing*0.3);probe_pos=original+probe_offset;
    }
    barrier();
    if(lane<count){
        float y=1.0-2.0*(float(lane)+0.5)/float(count);
        float angle=float(lane)*2.39996323+float(dispatch_info.z%1024u)*0.381966;
        float r=sqrt(max(1-y*y,0));vec3 dir=vec3(r*cos(angle),y,r*sin(angle));
        Hit hit=trace(probe_pos,dir,config.x,false);vec3 radiance=vec3(0);float back=0;
        uint state=(idx+1u)*747796405u^(lane+1u)*2891336453u^(dispatch_info.z+1u)*277803737u;state|=1u;
        if(!hit.found){clearReservoir(rb);radiance=dir.y>=0?mix(sky_horizon.rgb,sky_zenith.rgb,pow(clamp(dir.y,0,1),0.55)):mix(sky_horizon.rgb,sky_ground.rgb,clamp(-dir.y*4,0,1));}
        else if(hit.material<counts.z){
            vec3 n=hit.normal;back=dot(n,dir)>0?1.0:0.0;if(back>0)n=-n;
            vec3 p=probe_pos+dir*hit.t+n*0.005;uint mat=offsets.z+hit.material*8u;
            vec3 albedo=clamp(geom3(mat),vec3(0),vec3(0.95))*(1-clamp(uintBitsToFloat(geom[mat+3u]),0,1));
            bool stable=prevOff.w>0&&dispatch_info.w==0u&&length(probe_offset-prevOff.xyz)<0.05;
            vec3 direct=sampleDirect(p,n,rb,stable,state);
            vec3 sun=norm(sun_dir_int.xyz);float nl=max(dot(n,sun),0);
            if(sun_dir_int.w>0&&nl>0&&!trace(p,sun,1000,true).found)direct+=finiteRgb(sun_color.rgb*sun_dir_int.w*nl);
            vec4 previous=samplePrevious(p,n);
            radiance=geom3(mat+4u)+albedo*(direct/PI+previous.rgb*previous.a*config.z);
        }else clearReservoir(rb);
        ray_result[lane]=vec4(finiteRgb(radiance),hit.found?hit.t:config.x);
        ray_direction[lane]=vec4(dir,back);
    }else{clearReservoir(rb);ray_result[lane]=vec4(0);ray_direction[lane]=vec4(0);}
    barrier();
    if(lane==0u){
        float backs=0;for(uint i=0u;i<count;++i)backs+=ray_direction[i].w;
        float valid=backs*2.0>float(count)?0.0:1.0;
        float h=prevOff.w>0&&valid>0&&length(probe_offset-prevOff.xyz)<0.05&&dispatch_info.w==0u?config.y:0;
        uint outBase=offsets.w+base;
        for(uint a=0u;a<6u;++a){
            vec3 sum=vec3(0);float weights=0,dist=0,sq=0,n=0;
            for(uint i=0u;i<count;++i){float w=max(dot(ray_direction[i].xyz,axes[a]),0);sum+=ray_result[i].rgb*w;weights+=w;if(sector(ray_direction[i].xyz)==a){dist+=ray_result[i].w;sq+=ray_result[i].w*ray_result[i].w;n+=1;}}
            vec4 previous=old4(base+a*4u),mom=old4(base+24u+a*4u);float vh=mom.y>0?h:0;
            float mean=n>0?mix(dist/n,previous.w,vh):previous.w;
            float square=n>0?mix(sq/n,mom.x,vh):mom.x;
            store4(outBase+a*4u,vec4(mix(sum/max(weights,1e-6),previous.rgb,h),mean));
            store4(outBase+24u+a*4u,vec4(square,n>0?valid:(h>0?mom.y:0),0,0));
        }
        store4(outBase+48u,vec4(probe_offset,valid));
    }
}
