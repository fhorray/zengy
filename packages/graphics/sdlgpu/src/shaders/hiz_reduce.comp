#version 450
layout(local_size_x=16,local_size_y=16,local_size_z=1) in;
layout(set=0,binding=0) uniform sampler2D u_depth;
layout(std430,set=1,binding=0) buffer DepthBounds { vec2 bounds[]; };
layout(std140,set=2,binding=0) uniform ReduceParams {
    uvec4 src; // offset, width, height, base level flag
    uvec4 dst; // offset, width, height, unused
};
void main() {
    uvec2 p=gl_GlobalInvocationID.xy;
    if(any(greaterThanEqual(p,dst.yz))) return;
    vec2 result=vec2(1.0,0.0);
    if(src.w!=0u) {
        float d=texelFetch(u_depth,ivec2(p),0).r;
        if(isnan(d)||isinf(d)) d=1.0;
        result=vec2(clamp(d,0.0,1.0));
    } else {
        for(uint y=0u;y<2u;++y) for(uint x=0u;x<2u;++x) {
            uvec2 q=p*2u+uvec2(x,y);
            if(any(greaterThanEqual(q,src.yz))) continue;
            vec2 v=bounds[src.x+q.y*src.y+q.x];
            result=vec2(min(result.x,v.x),max(result.y,v.y));
        }
    }
    bounds[dst.x+p.y*dst.y+p.x]=result;
}
