#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout(set = 0, binding = 0) uniform sampler2D u_hdr;
layout(std430, set = 1, binding = 0) buffer HistogramBuffer {
    uint bins[64];
    float adapted_ev100;
    float target_ev100;
};
layout(std140, set = 2, binding = 0) uniform AutoExpParams {
    vec4 range_params;    // min_log2, inverse log range, sample-grid width, height
    vec4 metering_params; // x = center weighting strength, y = subpixel phase X, z = phase Y, w = maximum integer weight
};
shared uint local_bins[64];

void main() {
    uint tid = gl_LocalInvocationIndex;
    if (tid < 64u) local_bins[tid] = 0u;
    barrier();

    uvec2 gid = gl_GlobalInvocationID.xy;
    if (gid.x < uint(range_params.z) && gid.y < uint(range_params.w)) {
        // Stratify over the actual HDR image rather than averaging away small highlights.
        vec2 uv = (vec2(gid) + metering_params.yz) / range_params.zw;
        ivec2 size = textureSize(u_hdr, 0);
        ivec2 pixel = clamp(ivec2(uv * vec2(size)), ivec2(0), size - 1);
        vec3 col = texelFetch(u_hdr, pixel, 0).rgb;
        if (!any(isnan(col)) && !any(isinf(col))) {
            float lum = dot(max(col, vec3(0.0)), vec3(0.2126, 0.7152, 0.0722));
            // Bin 0 is underflow/black, bins 1..62 are equal-width intervals,
            // bin 63 is overflow. The adaptation shader uses the same convention.
            float min_log = range_params.x;
            float log_lum = log2(max(lum, 1e-30));
            float t = (log_lum - min_log) * range_params.y;
            uint bin = 0u;
            if (lum > 0.0 && t > 0.0) {
                bin = t >= 1.0 ? 63u : min(uint(t * 62.0) + 1u, 62u);
            }
            uint weight = 1u;
            if (metering_params.x > 0.0 && metering_params.w > 1.0) {
                vec2 delta = (uv - 0.5) * 2.0;
                float center = exp(-2.0 * dot(delta, delta));
                weight = uint(round(1.0 + (metering_params.w - 1.0) * metering_params.x * center));
            }
            atomicAdd(local_bins[bin], weight);
        }
    }
    barrier();
    if (tid < 64u && local_bins[tid] > 0u) atomicAdd(bins[tid], local_bins[tid]);
}
