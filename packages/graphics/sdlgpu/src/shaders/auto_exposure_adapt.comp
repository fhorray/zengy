#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
layout(r32f, set = 1, binding = 0) uniform writeonly image2D u_exposure_out;
layout(std430, set = 1, binding = 1) buffer HistogramBuffer {
    uint bins[64];
    float adapted_ev100;
    float target_ev100;
};
layout(std140, set = 2, binding = 0) uniform AdaptParams {
    vec4 ev_bounds;  // min/max relative EV, low/high percentile
    vec4 speed_dt;   // brighten, darken, dt, compensation EV
    vec4 hist_range; // min_log2, log range, state (1=continue, 2=reset), transition stops
    vec4 physical_params; // physical mode, log2 luminance calibration, reserved, reserved
};
shared uint s_bins[64];

float finiteOr(float x, float fallback) {
    return (isnan(x) || isinf(x)) ? fallback : x;
}

// Constant stops/second far from the target, exponential near it. Integrate the
// crossing analytically so a frame that crosses the threshold cannot overshoot.
float adaptEv(float current, float target, float speed, float dt, float transition) {
    float distance = abs(target - current);
    if (distance <= 1e-5 || speed <= 0.0 || dt <= 0.0) return current;
    if (transition <= 0.0) {
        // Legacy exponential mode: speed is measured in 1/second.
        return mix(current, target, 1.0 - exp(-speed * dt));
    }
    float linear_time = max(distance - transition, 0.0) / speed;
    float remaining = dt < linear_time
        ? distance - speed * dt
        : min(distance, transition) * exp(-speed * (dt - linear_time) / transition);
    return target + sign(current - target) * remaining;
}

void main() {
    uint idx = gl_LocalInvocationIndex;
    s_bins[idx] = bins[idx];
    bins[idx] = 0u;
    barrier();
    if (idx != 0u) return;

    float ev_a = clamp(finiteOr(ev_bounds.x, -4.0), -32.0, 32.0);
    float ev_b = clamp(finiteOr(ev_bounds.y, 8.0), -32.0, 32.0);
    float ev_min = min(ev_a, ev_b);
    float ev_max = max(ev_a, ev_b);
    bool reset = hist_range.z > 1.5;
    float prev = clamp(finiteOr(adapted_ev100, 0.0), ev_min, ev_max);
    float total = 0.0;
    for (uint i = 0u; i < 64u; ++i) total += float(s_bins[i]);
    if (total <= 0.0) {
        if (reset) prev = clamp(physical_params.x > 0.5 ? finiteOr(physical_params.z, 0.0) : 0.0, ev_min, ev_max);
        adapted_ev100 = prev;
        target_ev100 = prev;
        imageStore(u_exposure_out, ivec2(0), vec4(prev, 0.0, 0.0, 1.0));
        return;
    }

    float a = clamp(finiteOr(ev_bounds.z, 0.1), 0.0, 1.0);
    float b = clamp(finiteOr(ev_bounds.w, 0.9), 0.0, 1.0);
    float low = min(a, b);
    float high = max(a, b);
    if (high - low < 0.001) { low = 0.1; high = 0.9; }
    float low_count = total * low;
    float high_count = total * high;
    float accum = 0.0;
    float weighted_sum = 0.0;
    float weight_total = 0.0;
    for (uint i = 0u; i < 64u; ++i) {
        float next_acc = accum + float(s_bins[i]);
        float w = max(0.0, min(next_acc, high_count) - max(accum, low_count));
        float t = i == 0u ? 0.0 : (i == 63u ? 1.0 : (float(i) - 0.5) / 62.0);
        weighted_sum += (hist_range.x + t * hist_range.y) * w;
        weight_total += w;
        accum = next_acc;
    }
    // This is relative scene EV, not calibrated physical EV100. Retain the
    // existing postfx contract until the complete photometric migration.
    float avg_log2 = weight_total > 0.0 ? weighted_sum / weight_total : log2(0.18);
    float compensation = clamp(finiteOr(speed_dt.w, 0.0), -32.0, 32.0);
    // Reflected-light meter calibration constant K=12.5 at ISO 100.
    float metered_ev = physical_params.x > 0.5
        ? avg_log2 + physical_params.y + log2(100.0 / 12.5)
        : avg_log2 - log2(0.18);
    float target = clamp(metered_ev - compensation, ev_min, ev_max);
    target_ev100 = target;
    float speed = clamp(finiteOr(target < prev ? speed_dt.x : speed_dt.y, 1.0), 0.0, 64.0);
    float dt = clamp(finiteOr(speed_dt.z, 0.0), 0.0, 0.1);
    float transition = clamp(finiteOr(hist_range.w, 0.0), 0.0, 16.0);
    float next_ev = reset ? target : adaptEv(prev, target, speed, dt, transition);
    adapted_ev100 = next_ev;
    imageStore(u_exposure_out, ivec2(0), vec4(next_ev, 0.0, 0.0, 1.0));
}
